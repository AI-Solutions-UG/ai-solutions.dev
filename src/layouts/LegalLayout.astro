---
import '@fontsource-variable/inter';
import '@fontsource-variable/inter-tight';
import '@styles/home.css';

import Nav from '@components/home/Nav.astro';
import SiteFooter from '@components/home/SiteFooter.astro';

interface Props {
	title: string;
	updated?: string;
}
const { title, updated } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta name="theme-color" content="#f6f5f1" />
		<meta name="robots" content="noindex, follow" />
		<title>{title} – AI Solutions</title>
	</head>
	<body class="home">
		<Nav />
		<main class="legal">
			<div class="wrap legal__wrap">
				<header class="legal__head">
					<p class="eyebrow">Rechtliches</p>
					<h1>{title}</h1>
					{updated && <p class="legal__updated">Stand: {updated}</p>}
				</header>
				<div class="legal__body">
					<slot />
				</div>
			</div>
		</main>
		<SiteFooter />
	</body>
</html>
