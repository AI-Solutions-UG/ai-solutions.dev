---
import { contactHref } from './site';

const stations = [
	{ title: 'Beweisen', text: 'Ihr Problem, unser Prototyp. Kostenlos.' },
	{ title: 'Aufbauen', text: 'Ihr Team lernt mit uns, Software mit KI zu bauen.' },
	{ title: 'Selbst können', text: 'Sie entwickeln Ihre Software selbst.' },
];
---

<section class="hero" id="top">
	<div class="wrap">
		<p class="eyebrow">Kompetenzaufbau statt Agentur</p>
		<h1 class="hero__title">
			Ihren Vertrieb machen Sie selbst.
			<span class="accent">Bald auch Ihre Software.</span>
		</h1>
		<p class="hero__lead">
			KI macht eigene Software-Entwicklung für jedes Unternehmen möglich. Wir bauen diese Kompetenz bei Ihnen auf.
			Zuerst mit einem kostenlosen Prototyp für ein echtes Problem.
		</p>
		<div class="hero__actions">
			<a href={contactHref} class="btn">Problem schildern</a>
			<a href="#weg" class="btn btn--ghost">Warum jetzt? ↓</a>
		</div>

		<figure class="model" aria-label="Unser Modell: Beweisen, Aufbauen, Selbst können">
			<div class="model__track" aria-hidden="true">
				<span class="model__flow"></span>
				<span class="model__ends"><span>bei uns</span><span>bei Ihnen</span></span>
			</div>
			<ol class="model__stations">
				{
					stations.map((s, i) => (
						<li style={`--i:${i}`}>
							<span class="model__dot" aria-hidden="true">{i + 1}</span>
							<strong>{s.title}</strong>
							<span>{s.text}</span>
						</li>
					))
				}
			</ol>
			<figcaption class="model__caption">Die Kompetenz wandert von uns zu Ihnen. Software, Daten und Wissen gehören Ihnen.</figcaption>
		</figure>
	</div>
</section>
