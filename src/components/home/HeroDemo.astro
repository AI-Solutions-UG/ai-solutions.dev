---
// Animierte Demo im Hero: Ein Anliegen in Klartext, KI baut daraus eine Anwendung.
// Mehrere Beispiele laufen nacheinander durch; per Tab direkt anwählbar.
// Mock-Anwendungen sind deklarativ: Elemente mit data-at="n" erscheinen ab Schritt n,
// data-until="n" blendet sie ab Schritt n wieder aus, data-count-to zählt hoch.
const scenarios = [
	{
		id: 'konfigurator',
		label: 'Konfigurator',
		url: 'konfigurator.ihr-unternehmen.de',
		prompt: 'Wir brauchen einen Konfigurator für unsere Schränke. Mit Preis und Stückliste für die Fertigung.',
		steps: ['Datenmodell aus Ihrer Preisliste', 'Regeln für Breite, Türen und Oberfläche', 'Preis wird live berechnet', 'Stückliste für die Fertigung'],
	},
	{
		id: 'angebot',
		label: 'Angebote',
		url: 'angebote.ihr-unternehmen.de',
		prompt: 'Unsere Angebote tippen wir in Word ab. Sie sollen automatisch aus Artikeln und Preisen entstehen.',
		steps: ['Artikel und Preise übernommen', 'Rabatte und Staffelpreise', 'PDF in Ihrem Layout', 'Versand per E-Mail'],
	},
	{
		id: 'crm',
		label: 'CRM',
		url: 'crm.ihr-unternehmen.de',
		prompt: 'Unsere Kundenkontakte liegen in Excel und Outlook. Wir wollen sehen, wo welcher Kunde steht.',
		steps: ['Kontakte aus Excel importiert', 'E-Mails den Kunden zugeordnet', 'Vertriebsphasen auf einen Blick', 'Erinnerungen an Wiedervorlagen'],
	},
	{
		id: 'controlling',
		label: 'Controlling',
		url: 'controlling.ihr-unternehmen.de',
		prompt: 'Unser Monatsreporting bauen wir jedes Mal von Hand in Excel. Das soll auf Knopfdruck gehen.',
		steps: ['Buchhaltung angebunden', 'Kennzahlen festgelegt', 'Dashboard für die Geschäftsführung', 'Jeden Morgen aktuell'],
	},
	{
		id: 'import',
		label: 'Schnittstellen',
		url: 'import.ihr-unternehmen.de',
		prompt: 'Unser Lieferant schickt Preislisten als Excel. Die tippen wir ins ERP ab.',
		steps: ['Excel-Format erkannt', 'Felder dem ERP zugeordnet', 'Fehler werden markiert', 'Import mit einem Klick'],
	},
	{
		id: 'shop',
		label: 'Händler-Shop',
		url: 'shop.ihr-unternehmen.de',
		prompt: 'Unsere Händler bestellen per Telefon und Fax. Wir wollen einen einfachen Online-Shop für sie.',
		steps: ['Artikel und Händlerpreise', 'Eigener Login pro Händler', 'Warenkorb und Bestellung', 'Weitergabe an den Auftrag'],
	},
	{
		id: 'marketing',
		label: 'Marketing',
		url: 'newsletter.ihr-unternehmen.de',
		prompt: 'Wir wollen jeden Monat einen Newsletter verschicken. Aber niemand hat Zeit zum Schreiben.',
		steps: ['Neuigkeiten und Produkte gesammelt', 'Texte in Ihrem Ton', 'Empfängerlisten gepflegt', 'Versand automatisch geplant'],
	},
	{
		id: 'cms',
		label: 'Website',
		url: 'cms.ihr-unternehmen.de',
		prompt: 'Unsere Website pflegt eine Agentur. Wir wollen Inhalte selbst ändern können.',
		steps: ['Seiten übernommen', 'Bausteine für Ihr Design', 'Bearbeiten ohne Technik', 'Veröffentlichen mit einem Klick'],
	},
];
---

<figure class="demo" data-demo data-phase="0" aria-label="Animierte Beispiele: Aus einem Satz wird eine funktionierende Anwendung">
	<div class="demo__tabs" role="tablist" aria-label="Beispiele">
		{
			scenarios.map((s, i) => (
				<button type="button" role="tab" class="demo__tab" data-tab={i} aria-selected={i === 0 ? 'true' : 'false'}>
					{s.label}
