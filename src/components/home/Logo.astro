---
// Wort-Bild-Marke: drei Standard-Bausteine, ein individueller (Kreis in Kupfer).
interface Props {
	tone?: 'dark' | 'light';
	withText?: boolean;
	class?: string;
}
const { tone = 'dark', withText = true, class: className } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`, className]}>
	<svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true">
		<rect x="0" y="0" width="17" height="17" rx="4" class="logo__block"></rect>
		<rect x="0" y="23" width="17" height="17" rx="4" class="logo__block"></rect>
		<rect x="23" y="23" width="17" height="17" rx="4" class="logo__block"></rect>
		<circle cx="31.5" cy="8.5" r="8.5" class="logo__piece"></circle>
	</svg>
	{withText && <span class="logo__text">AI Solutions</span>}
</span>
