---
import '@fontsource-variable/inter';
import '@fontsource-variable/inter-tight';
import '@styles/home.css';

import Nav from '@components/home/Nav.astro';
import Hero from '@components/home/Hero.astro';
import Path from '@components/home/Path.astro';
import Bottleneck from '@components/home/Bottleneck.astro';
import Offer from '@components/home/Offer.astro';
import UseCases from '@components/home/UseCases.astro';
import About from '@components/home/About.astro';
import Faq from '@components/home/Faq.astro';
import Contact from '@components/home/Contact.astro';
import SiteFooter from '@components/home/SiteFooter.astro';

const title = 'AI Solutions – Individuelle Software mit KI für den Mittelstand';
const description =
	'KI macht maßgeschneiderte Software für den Mittelstand bezahlbar. Wir beweisen es an einem echten Problem aus Ihrem Unternehmen – kostenlos – und bringen die Kompetenz dann zu Ihnen ins Haus.';
const isPreview = import.meta.env.BASE_URL !== '/';
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
		<meta name="theme-color" content="#f6f5f1" />
		<meta name="generator" content={Astro.generator} />
		{isPreview && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content="https://ai-solutions.dev/" />
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body class="home">
		<Nav />
		<main>
			<Hero />
			<Path />
			<Bottleneck />
			<Offer />
			<UseCases />
			<About />
			<Faq />
			<Contact />
		</main>
		<SiteFooter />

		<script>
			// Reveal sections as they scroll into view. Content is fully visible without JS.
			const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
				items.forEach((el) => el.classList.add('is-visible'));
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								io.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: '0px 0px -10% 0px' },
				);
				items.forEach((el) => io.observe(el));
			}
		</script>
	</body>
</html>
