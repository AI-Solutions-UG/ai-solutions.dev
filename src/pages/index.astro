<style>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	:root {
		--bg-dark: #0a0a0f;
		--bg-darker: #050508;
		--accent-purple: #8b5cf6;
		--accent-blue: #3b82f6;
		--accent-cyan: #06b6d4;
		--text-white: #f8fafc;
	}

	html, body {
		height: 100%;
		overflow: hidden;
	}

	body {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		background: linear-gradient(135deg, var(--bg-darker) 0%, var(--bg-dark) 50%, #0f0f1a 100%);
		color: var(--text-white);
		position: relative;
	}

	.container {
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		overflow: hidden;
	}

	.glow-orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(100px);
		opacity: 0.3;
		animation: pulse 8s ease-in-out infinite;
	}

	.glow-orb-1 {
		width: 500px;
		height: 500px;
		background: radial-gradient(circle, var(--accent-purple) 0%, transparent 70%);
		top: -200px;
		right: -100px;
		animation-delay: 0s;
	}

	.glow-orb-2 {
		width: 600px;
		height: 600px;
		background: radial-gradient(circle, var(--accent-cyan) 0%, transparent 70%);
		bottom: -250px;
		left: -150px;
		animation-delay: 2s;
	}

	@keyframes pulse {
		0%, 100% {
			transform: scale(1) translate(0, 0);
			opacity: 0.3;
		}
		50% {
			transform: scale(1.1) translate(20px, -20px);
			opacity: 0.4;
		}
	}

	.title {
		font-size: clamp(2.5rem, 8vw, 5.5rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		text-align: center;
		position: relative;
		z-index: 10;
		background: linear-gradient(135deg, 
			var(--text-white) 0%, 
			#e0e7ff 30%, 
			var(--accent-purple) 60%, 
			var(--accent-cyan) 100%
		);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: fadeInUp 1.2s ease-out, shimmer 8s ease-in-out infinite;
		padding: 0 2rem;
		line-height: 1.2;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes shimmer {
		0%, 100% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
	}

	/* Subtle grid pattern overlay */
	body::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-image: 
			linear-gradient(rgba(139, 92, 246, 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(139, 92, 246, 0.03) 1px, transparent 1px);
		background-size: 50px 50px;
		pointer-events: none;
	}

	@media (max-width: 768px) {
		.glow-orb-1 {
			width: 300px;
			height: 300px;
		}
		
		.glow-orb-2 {
			width: 350px;
			height: 350px;
		}
	}
</style>
