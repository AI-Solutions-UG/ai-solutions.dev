---
import { Footer } from '@components/Footer';
import '@styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<meta name="theme-color" content="#0a0a0f" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="generator" content={Astro.generator} />
		<title>Privacy Policy - AI Solutions</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="page-content privacy-container">
			<header>
				<h1>Privacy Policy</h1>
				<p class="effective-date">Effective Date: March 1, 2026</p>
			</header>

			<main>
				<section>
					<h2>1. Introduction</h2>
					<p>
						This privacy policy applies to the website ai-solutions.dev (the "Website") operated by 
						AI Solutions UG (haftungsbeschränkt) ("we", "us", or "our").
					</p>
					<p>
						This is a static informational website hosted on GitHub Pages. We are committed to protecting your privacy.
					</p>
				</section>

				<section>
					<h2>2. Information We Collect</h2>
					<p>
						This Website is a static website and does not actively collect, store, or process any personal data from visitors.
					</p>
					
					<h3>2.1 Automatically Collected Information</h3>
					<p>
						When you visit this Website, GitHub Pages (our hosting provider) may automatically collect certain technical information, including:
					</p>
					<ul>
						<li>IP addresses</li>
						<li>Browser type and version</li>
						<li>Operating system</li>
						<li>Referring website</li>
						<li>Pages visited and time spent</li>
						<li>Date and time of access</li>
					</ul>
					<p>
						This information is collected and processed by GitHub, Inc. and is subject to 
						<a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement" target="_blank" rel="noopener noreferrer">GitHub's Privacy Statement</a>.
					</p>

					<h3>2.2 Cookies</h3>
					<p>
						This Website does not use cookies or similar tracking technologies. However, GitHub Pages may use cookies 
						for operational purposes. Please refer to GitHub's Privacy Statement for more information.
					</p>
				</section>

				<section>
					<h2>3. How We Use Information</h2>
					<p>
						Since we do not actively collect personal information through this Website, we do not use, share, or process your data.
					</p>
					<p>
						Any data collected by GitHub Pages is used solely for hosting and delivering the Website to you.
					</p>
				</section>

				<section>
					<h2>4. Third-Party Services</h2>
					
					<h3>4.1 GitHub Pages</h3>
					<p>
						This Website is hosted on GitHub Pages, a service provided by GitHub, Inc. GitHub may collect technical 
						information as described in their privacy statement. We do not have control over GitHub's data collection practices.
					</p>
					<p>
						Learn more: <a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement" target="_blank" rel="noopener noreferrer">GitHub Privacy Statement</a>
					</p>

					<h3>4.2 Google Fonts</h3>
					<p>
						This Website uses Google Fonts to display fonts. When you visit our Website, your browser may load fonts 
						directly from Google's servers. This may result in Google collecting your IP address and other technical information.
					</p>
					<p>
						Learn more: <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google Privacy Policy</a>
					</p>
				</section>

				<section>
					<h2>5. External Links</h2>
					<p>
						This Website may contain links to external websites or applications (such as our Reframe AI app). 
						We are not responsible for the privacy practices or content of those external sites. 
						Please review their respective privacy policies before providing any personal information.
					</p>
				</section>

				<section>
					<h2>6. Data Security</h2>
					<p>
						As a static website, we do not store or process personal data. All connections to this Website are encrypted using HTTPS/TLS.
					</p>
				</section>

				<section>
					<h2>7. Your Rights</h2>
					<p>
						Since we do not collect or store personal data through this Website, there is no data that we can access, 
						modify, or delete on your behalf. For any data collected by GitHub Pages, please contact GitHub directly.
					</p>
				</section>

				<section>
					<h2>8. Children's Privacy</h2>
					<p>
						This Website is not directed to individuals under the age of 18. We do not knowingly collect 
						personal information from children.
					</p>
				</section>

				<section>
					<h2>9. Changes to This Privacy Policy</h2>
					<p>
						We may update this Privacy Policy from time to time. Any changes will be posted on this page with 
						an updated "Effective Date" at the top.
					</p>
				</section>

				<section>
					<h2>10. Contact Us</h2>
					<p>If you have any questions about this Privacy Policy, please contact us:</p>
					
					<div class="contact-info">
						<p><strong>AI Solutions UG (haftungsbeschränkt)</strong></p>
						<p>Email: <a href="mailto:privacy@ai-solutions.dev">privacy@ai-solutions.dev</a></p>
					</div>
				</section>
			</main>

			<footer>
				<p>Last updated: March 1, 2026</p>
			</footer>
		</div>
		<Footer client:load left={[{ href: '/', label: 'Home' }]} />
	</body>
</html>

<style>
	.privacy-container {
		max-width: 800px;
		width: 100%;
		margin: 0 auto;
		padding: 3rem 2rem;
		color: #f8fafc;
		line-height: 1.7;
	}

	header {
		margin-bottom: 3rem;
		border-bottom: 2px solid rgba(139, 92, 246, 0.3);
		padding-bottom: 2rem;
	}

	h1 {
		font-size: 2.5rem;
		font-weight: 700;
		color: #fff;
		margin-bottom: 0.5rem;
		background: linear-gradient(135deg, #fff 0%, #8b5cf6 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.effective-date {
		color: #94a3b8;
		font-size: 0.95rem;
	}

	main {
		margin-bottom: 4rem;
	}

	section {
		margin-bottom: 3rem;
	}

	h2 {
		font-size: 1.75rem;
		font-weight: 600;
		color: #fff;
		margin-bottom: 1rem;
		margin-top: 2rem;
	}

	h3 {
		font-size: 1.25rem;
		font-weight: 600;
		color: #e0e7ff;
		margin-top: 1.5rem;
		margin-bottom: 0.75rem;
	}

	p {
		margin-bottom: 1rem;
		color: #cbd5e1;
	}

	ul {
		margin-bottom: 1.5rem;
		margin-left: 1.5rem;
		color: #cbd5e1;
	}

	li {
		margin-bottom: 0.5rem;
	}

	strong {
		color: #e0e7ff;
		font-weight: 600;
	}

	a {
		color: #8b5cf6;
		text-decoration: none;
		transition: color 0.2s;
	}

	a:hover {
		color: #a78bfa;
		text-decoration: underline;
	}

	.contact-info {
		background: rgba(139, 92, 246, 0.1);
		border-left: 3px solid #8b5cf6;
		padding: 1.5rem;
		margin: 1.5rem 0;
		border-radius: 4px;
	}

	.contact-info p {
		margin-bottom: 0.5rem;
	}

	footer {
		border-top: 2px solid rgba(139, 92, 246, 0.3);
		padding-top: 2rem;
		text-align: center;
		color: #94a3b8;
		font-size: 0.9rem;
	}

	footer p {
		margin-bottom: 0.5rem;
	}

	@media (max-width: 768px) {
		.privacy-container {
			padding: 2rem 1.5rem;
		}

		h1 {
			font-size: 2rem;
		}

		h2 {
			font-size: 1.5rem;
		}

		h3 {
			font-size: 1.1rem;
		}
	}
</style>
